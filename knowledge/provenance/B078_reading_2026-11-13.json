  "notes": [
    {
      "heading": "开场用真实情境也可直接认识",
      "source_locator": "顺序项3，第一章开场结构与各场所例。",
      "bound_methods": [
        "M25"
      ]
    },
    {
      "heading": "公共场合先核是否方便交谈",
      "source_locator": "顺序项3，自习室、图书馆、公交、咖啡厅、广场和街搭。",
      "bound_methods": []
    },
    {
      "heading": "过渡分享一件真实相关的事",
      "source_locator": "顺序项4，第二章框架、22项原则与例说。",
      "bound_methods": [
        "M10"
      ]
    },
    {
      "heading": "共同梗和角色由双方一起接",
      "source_locator": "顺序项5，第三章第4、9、10类；顺序项6，第4—5例。",
      "bound_methods": [
        "M05",
        "M07"
      ]
    },
    {
      "heading": "玩笑可以把笑点放在自己",
      "source_locator": "顺序项5，骄傲风趣与误解；顺序项6，第4—5例；顺序项8—9的应答材料。",
      "bound_methods": [
        "M06"
      ]
    },
    {
      "heading": "具体欣赏不先制造自我怀疑",
      "source_locator": "顺序项5，第12类；顺序项6，培养舒适感；顺序项9，打压理论；顺序项10，潜力奉承。",
      "bound_methods": [
        "M09"
      ]
    },
    {
      "heading": "先分清提问求助和边界",
      "source_locator": "顺序项8，第六章五分类与50组应答。",
      "bound_methods": [
        "M04"
      ]
    },
    {
      "heading": "愿意帮忙不用换取配合",
      "source_locator": "顺序项8，劳务服从分类及求助应答；顺序项12，长期关系准则。",
      "bound_methods": [
        "M13"
      ]
    },
    {
      "heading": "有依据的观察始终允许纠正",
      "source_locator": "顺序项10，第八章定义、具体使用及112条编号材料。",
      "bound_methods": [
        "M08",
        "M20"
      ]
    },
    {
      "heading": "困扰先听实际内容而非给保证",
      "source_locator": "顺序项10，同步呼吸与武断劝慰；顺序项12，疏导情绪及第7例。",
      "bound_methods": [
        "M11"
      ]
    },
    {
      "heading": "真实邀约说清愿意参加什么",
      "source_locator": "顺序项4，第7—8类；顺序项5，第13—16类；顺序项12，第2—3例。",
      "bound_methods": [
        "M14"
      ]
    },
    {
      "heading": "说定后的可靠比反差更具体",
      "source_locator": "顺序项12，第3—4例和不可预测准则。",
      "bound_methods": [
        "M15"
      ]
    },
    {
      "heading": "边界管理自己的参与",
      "source_locator": "顺序项4，无需求感与准则；顺序项12，框架四等级和人格独立。",
      "bound_methods": [
        "M22"
      ]
    },
    {
      "heading": "不把单边维持变成冷落训练",
      "source_locator": "顺序项5，悬念、猫绳与丢失宠物类；顺序项9，情感投资；顺序项12，发情绪准则。",
      "bound_methods": [
        "M19"
      ]
    },
    {
      "heading": "拒绝与纠正不改写为喜欢",
      "source_locator": "顺序项6，沉默与讨厌的例说；顺序项8，第25—33、42、50组；顺序项12，第6例。",
      "bound_methods": [
        "M23"
      ]
    },
    {
      "heading": "熟悉气氛和游戏不代替同意",
      "source_locator": "顺序项6，第9例；顺序项7，12组身体接触例说；顺序项11，诱惑理论及例说。",
      "bound_methods": []
    },
    {
      "heading": "有实际伤害才对那件事负责",
      "source_locator": "顺序项9，打压过度的道歉段；顺序项12，第5、7例。",
      "bound_methods": [
        "M21"
      ]
    },
    {
      "heading": "共同活动不是人格测验",
      "source_locator": "顺序项9，脑筋急转弯；顺序项10，九类使用与编号7—9等材料。",
      "bound_methods": []
    },
    {
      "heading": "长期相处不索密码和控制社交",
      "source_locator": "顺序项12，松紧有度与其他长期关系准则。",
      "bound_methods": []
    },
    {
      "heading": "来源汇编和机制声称分开记录",
      "source_locator": "序、第二至三章理论、第六至十章全范围。",
      "bound_methods": []
    }
  ],

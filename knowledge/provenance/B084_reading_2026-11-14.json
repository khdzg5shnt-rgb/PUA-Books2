  "original_note_groups": 26,
  "new_exact_method_section_bindings": 17,
  "notes": [
    {
      "heading": "当前文件与目录页码分开记录",
      "file_location": "P1—2封面与目录；P39结尾。",
      "bound_methods": []
    },
    {
      "heading": "履历竞赛和百分比不证明效果",
      "file_location": "P2—8作者介绍、竞赛、社区历史；P39课程推介。",
      "bound_methods": []
    },
    {
      "heading": "了解方法适用条件而不背整套流程",
      "file_location": "P8—12，对三种方法的评论。",
      "bound_methods": [
        "M26"
      ]
    },
    {
      "heading": "自身特点不等于缺陷清单",
      "file_location": "P8—9，作者列举个人条件。",
      "bound_methods": [
        "M25"
      ]
    },
    {
      "heading": "紧张可以承认不必先清零",
      "file_location": "P12—14，焦虑、抵抗与注意焦点。",
      "bound_methods": [
        "M25"
      ]
    },
    {
      "heading": "开口仍要看现场和对方是否方便",
      "file_location": "P14—16，开关比喻、环境与行动。",
      "bound_methods": [
        "M25"
      ]
    },
    {
      "heading": "不把陌生人当训练配额",
      "file_location": "P12、P15—16，指定接近次数、热身和高压场景。",
      "bound_methods": [
        "M22"
      ]
    },
    {
      "heading": "没有经验不削弱表达与拒绝的权利",
      "file_location": "P16—19，作者的性焦虑解释。",
      "bound_methods": [
        "M23"
      ]
    },
    {
      "heading": "信念用事实修正而不换一套保证",
      "file_location": "P18—19，负面信念、自我形象和成功障碍。",
      "bound_methods": [
        "M01"
      ]
    },
    {
      "heading": "保留普通生活与朋友",
      "file_location": "P19，社区优越感及对普通人的贬损。",
      "bound_methods": []
    },
    {
      "heading": "外在准备按本人选择与实际需要",
      "file_location": "P19—22，服装、仪容及声音。",
      "bound_methods": []
    },
    {
      "heading": "表达清楚不靠眼神和姿势证明地位",
      "file_location": "P21—23，身体语言、声调与目光。",
      "bound_methods": [
        "M26"
      ]
    },
    {
      "heading": "提问与自我表达都可自然使用",
      "file_location": "P23—25，十一项谈话提醒。",
      "bound_methods": [
        "M04"
      ]
    },
    {
      "heading": "开场不承担维持整场的义务",
      "file_location": "P23—24，三至五分钟与九比一比例。",
      "bound_methods": [
        "M19"
      ]
    },
    {
      "heading": "分享真实细节不伪造好奇钩子",
      "file_location": "P24—25，自我分享、感官细节和展示。",
      "bound_methods": [
        "M10"
      ]
    },
    {
      "heading": "先接住一个话题再决定是否展开",
      "file_location": "P24—25，多重脉络与相关性。",
      "bound_methods": [
        "M03"
      ]
    },
    {
      "heading": "不为赢争论攻击也不放弃正常边界",
      "file_location": "P24，关于争辩的提醒。",
      "bound_methods": [
        "M22"
      ]
    },
    {
      "heading": "共同情境比乱抛材料更有用",
      "file_location": "P25，环境相关的谈话。",
      "bound_methods": [
        "M05"
      ]
    },
    {
      "heading": "相关不是因果个案也不能补成定论",
      "file_location": "P33—34，孔雀风格与因果讨论。",
      "bound_methods": []
    },
    {
      "heading": "复盘先核事实再选一项可改动作",
      "file_location": "P26—28，模式、基线与五步症结分析；P30—32日志框架。",
      "bound_methods": []
    },
    {
      "heading": "资料缩成当前一项而不是更多套路",
      "file_location": "P28—30，信息超载与小组块。",
      "bound_methods": [
        "M26"
      ]
    },
    {
      "heading": "来源质量不能靠退款和成功故事判定",
      "file_location": "P29—30，来源选择与长期坚持。",
      "bound_methods": []
    },
    {
      "heading": "学习偏好不当固定学习类型",
      "file_location": "P34—35，教学差异、代表系统与三类学习者。",
      "bound_methods": []
    },
    {
      "heading": "目标是本人愿意的生活而非圈内战绩",
      "file_location": "P36—38，目标、希望、期限及十项总结。",
      "bound_methods": [
        "M25"
      ]
    },
    {
      "heading": "得到号码后仍看实际双向安排",
      "file_location": "P27，号码与时间桥梁；P36—37，结果目标。",
      "bound_methods": [
        "M14"
      ]
    },
    {
      "heading": "教学日志与宣传不新增私人记录",
      "file_location": "P31—32，训练日志；P38—39，总结与推介。",
      "bound_methods": []
    }
  ],

  "extra_embedded_files": 0,
  "annotations": 0,
  "external_targets_opened": false,
  "original_note_groups": 31,
  "new_exact_method_section_bindings": 55,
  "notes": [
    {
      "heading": "这是五组英中文文章，不是完整课程",
      "file_location": "P1—2前言；P3—8/9—12、13—20/21—26、27—30/31—33、34—35/36—37、38—42/43—45；P46后记",
      "bound_methods": []
    },
    {
      "heading": "课程宣传数字不作为社交效果证据",
      "file_location": "P2；P3—4、13—15、21—22及各篇结尾",
      "bound_methods": []
    },
    {
      "heading": "时空与既有安排会限制见面，不能全归责聊天技巧",
      "file_location": "英文P3—4；中文P9—10",
      "bound_methods": [
        "M01",
        "M17"
      ]
    },
    {
      "heading": "共同活动是实际场景，不是给人排等级的工具",
      "file_location": "英文P7—8；中文P11—12",
      "bound_methods": [
        "M25",
        "M10"
      ]
    },
    {
      "heading": "联系人不是资源名额，朋友也不须提供恋爱回报",
      "file_location": "英文P5—6；中文P10—11",
      "bound_methods": [
        "M22"
      ]
    },
    {
      "heading": "十五人层级只记为作者说法，不做配额",
      "file_location": "英文P5—7；中文P11",
      "bound_methods": []
    },
    {
      "heading": "朋友介绍后可以正常问好与接共同情境",
      "file_location": "英文P15—16；中文P22—23",
      "bound_methods": [
        "M25",
        "M04"
      ]
    },
    {
      "heading": "介绍关系不等于已跨过吸引阶段",
      "file_location": "英文P15—16；中文P22—24",
      "bound_methods": [
        "M01"
      ]
    },
    {
      "heading": "交谈结束看真实安排，不执行两分钟自动撤离",
      "file_location": "英文P15—16；中文P22—23",
      "bound_methods": [
        "M02",
        "M26"
      ]
    },
    {
      "heading": "朋友或组织者不能替她同意见面",
      "file_location": "英文P16、19；中文P23、26",
      "bound_methods": [
        "M14",
        "M22",
        "M23"
      ]
    },
    {
      "heading": "真实被了解，不伪造预选或利用嫉妒",
      "file_location": "英文P16—18；中文P23—25",
      "bound_methods": [
        "M10",
        "M22"
      ]
    },
    {
      "heading": "组织活动落实日期与内容，不把参与算作恋爱表态",
      "file_location": "英文P17；中文P24；英文P7及中文P12的聚会说明",
      "bound_methods": [
        "M14",
        "M15"
      ]
    },
    {
      "heading": "共同话题可以回扣，不需要持续表演或强占注意",
      "file_location": "英文P17—18；中文P24—25",
      "bound_methods": [
        "M03",
        "M05"
      ]
    },
    {
      "heading": "神经名词不证明可以控制某人的注意",
      "file_location": "英文P17；中文P25",
      "bound_methods": []
    },
    {
      "heading": "多次碰面不保证升温，单边循环要收住",
      "file_location": "英文P18—19；中文P25—26",
      "bound_methods": [
        "M17",
        "M19"
      ]
    },
    {
      "heading": "笑与拨头发不能授权身体接近",
      "file_location": "英文P18—19；中文P25—26",
      "bound_methods": [
        "M01",
        "M23"
      ]
    },
    {
      "heading": "尊重隐私与保持自主同时成立",
      "file_location": "英文P19—20；中文P25—26",
      "bound_methods": [
        "M22",
        "M23"
      ]
    },
    {
      "heading": "不用成为每个群体最强势的人",
      "file_location": "英文P27—30；中文P31—33",
      "bound_methods": [
        "M03",
        "M22"
      ]
    },
    {
      "heading": "排斥与打压可能有外部原因，但动机不能猜成事实",
      "file_location": "英文P27—28；中文P31—32",
      "bound_methods": [
        "M01",
        "M22"
      ]
    },
    {
      "heading": "介绍朋友要基于真实联系，不虚构圈层身份",
      "file_location": "英文P29—30；中文P33",
      "bound_methods": [
        "M10",
        "M22"
      ]
    },
    {
      "heading": "社交树是比喻，原文跨树与树内术语自相矛盾",
      "file_location": "英文P30；中文P33",
      "bound_methods": []
    },
    {
      "heading": "边界译成框架时，应回到真实可接受范围",
      "file_location": "英文P34第1项；中文P36第1项；英文P35第20项及中文P37第20项",
      "bound_methods": [
        "M22",
        "M23"
      ]
    },
    {
      "heading": "真诚欣赏与一起高兴，不必故意憋笑",
      "file_location": "英文P34—35第7、9项；中文P36第7、9项",
      "bound_methods": [
        "M09",
        "M12",
        "M26"
      ]
    },
    {
      "heading": "歉意针对已核过失，不为少道歉忽略修复",
      "file_location": "英文P35第11项；中文P37第11项",
      "bound_methods": [
        "M20",
        "M21"
      ]
    },
    {
      "heading": "表达困扰与求助不等于低价值",
      "file_location": "英文P35第16—18项；中文P37第16—18项",
      "bound_methods": [
        "M11",
        "M13"
      ]
    },
    {
      "heading": "时间相互尊重，不设迟到和通话的统一秒表",
      "file_location": "英文P35第15项；中文P37第15项；英文P16及中文P23",
      "bound_methods": [
        "M02",
        "M15",
        "M22"
      ]
    },
    {
      "heading": "投资译词不能把服从改成双向兴趣证据",
      "file_location": "英文P38—42；中文P43—45",
      "bound_methods": [
        "M01",
        "M19"
      ]
    },
    {
      "heading": "共同经历可以回扣，负面经历不能当制造联系的办法",
      "file_location": "英文P39—41；中文P44—45",
      "bound_methods": [
        "M05",
        "M23"
      ]
    },
    {
      "heading": "推进看具体愿意做什么，不靠服从阈值",

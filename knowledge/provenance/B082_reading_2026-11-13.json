  "original_note_groups": 16,
  "new_exact_method_section_bindings": 14,
  "notes": [
    {
      "heading": "署名和经验不等于经过效果验证",
      "file_location": "P1—4封面、译者序、目录与作者自序；P29结论。",
      "bound_methods": []
    },
    {
      "heading": "带着一点紧张也可以正常认识",
      "file_location": "P2、P7、P11—12、P29，承认恐惧与不再对抗。",
      "bound_methods": [
        "M25"
      ]
    },
    {
      "heading": "先看现场条件再决定是否开口",
      "file_location": "P7—12，作者对风险、目光与权力的解释；P22—24，场景选择。",
      "bound_methods": [
        "M25"
      ]
    },
    {
      "heading": "小步实践不设人数和日期配额",
      "file_location": "P6、P24—25，渐进改变与先适应环境。",
      "bound_methods": [
        "M25"
      ]
    },
    {
      "heading": "开场简单真实且留出选择",
      "file_location": "P24—25，普通招呼与简单开场。",
      "bound_methods": [
        "M25",
        "M26"
      ]
    },
    {
      "heading": "分享生活不靠虚构贵人身份",
      "file_location": "P13，创造价值、星探和中奖比喻；P24—25。",
      "bound_methods": [
        "M10"
      ]
    },
    {
      "heading": "平等不靠贬低对方来换自信",
      "file_location": "P10、P13、P22—23，权力、价值和外貌排名。",
      "bound_methods": [
        "M22"
      ]
    },
    {
      "heading": "猜测和永久预言都先留在未知",
      "file_location": "P14—18，读心、标签、过分归纳与比较。",
      "bound_methods": [
        "M08"
      ]
    },
    {
      "heading": "真实低投入不能靠积极改写抹掉",
      "file_location": "P16—17，对未回复、打断与预测的例子；P23，反应不佳的解释。",
      "bound_methods": [
        "M19"
      ]
    },
    {
      "heading": "真诚欣赏不要求她回以笑容",
      "file_location": "P22—23，赞美与不求回报。",
      "bound_methods": [
        "M09"
      ]
    },
    {
      "heading": "职业礼貌不当私人发展意愿",
      "file_location": "P22—23，服务人员与所谓雇佣对象。",
      "bound_methods": [
        "M25"
      ]
    },
    {
      "heading": "交朋友不把朋友当吸引力道具",
      "file_location": "P26，朋友、预选与热身建议。",
      "bound_methods": [
        "M10"
      ]
    },
    {
      "heading": "改变不必先羞辱自己或制造痛苦",
      "file_location": "P5—6、P19—21，痛苦阈限和负面激发。",
      "bound_methods": [
        "M22"
      ]
    },
    {
      "heading": "情绪与拒绝都不必被强行改造成好事",
      "file_location": "P16—18，必须和比较；P27—29，重新定位拒绝与恐惧。",
      "bound_methods": [
        "M22"
      ]
    },
    {
      "heading": "练习记录只留自己的可改动作",
      "file_location": "P14—18，空表和思维回看；P22、P25，拍摄与日历奖励。",
      "bound_methods": []
    },
    {
      "heading": "进化神经解释和漂亮图表都须另核",
      "file_location": "P8—11、P19—21、P26—28，机制、统计和图示。",
      "bound_methods": []
    }
  ],

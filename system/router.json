{
  "schema_version": 1,
  "version": "1.4.0",
  "updated": "2026-11-12",
  "description": "按已核事实选一个动作的规则路由，不是兴趣分类器或成功率模型",
  "input_policy": "由读图者先核原文与时间线，再填写有限事实；不从孤立关键词自动判断动机",
  "defaults": {
    "speaker_verified": false,
    "text_legible": false,
    "pending_reply": false,
    "necessary_new_logistics": false,
    "refusal_scope": "none",
    "boundary_expressed": false,
    "repair_needed": false,
    "invitation": "none",
    "function": "unknown",
    "closed_answer_complete": false,
    "consecutive_low_rounds": 0,
    "current_turn_low": false,
    "reciprocity": "unknown",
    "goal": "reply",
    "invite_ready": false,
    "user_availability_known": false,
    "activity_verified": false,
    "shared_callback_available": false,
    "roleplay_shared": false,
    "advice_requested": false,
    "urgent_practical_need": false,
    "latest_sender": "unknown",
    "current_scope_relation": "unknown"
  },
  "enums": {
    "refusal_scope": [
      "none",
      "contact",
      "physical",
      "romance",
      "activity",
      "channel"
    ],
    "invitation": [
      "none",
      "accepted",
      "alternative",
      "cancelled_with_repair",
      "no_alternative",
      "cancelled_without_repair",
      "open_to_activity"
    ],
    "function": [
      "unknown",
      "insult",
      "logistics",
      "correction",
      "distress",
      "advice_request",
      "good_news",
      "question",
      "post_date",
      "banter",
      "opening",
      "sharing",
      "appreciation"
    ],
    "reciprocity": [
      "unknown",
      "mutual",
      "consistently_one_sided"
    ],
    "goal": [
      "reply",
      "invite",
      "appreciate"
    ],
    "latest_sender": [
      "unknown",
      "user",
      "other"
    ],
    "current_scope_relation": [
      "unknown",
      "same",
      "different"
    ]
  },
  "routing": "first_matching_rule",
  "routes": [
    {
      "id": "R00",
      "name": "输入核对",
      "when": {
        "any": [
          {
            "field": "speaker_verified",
            "op": "eq",
            "value": false
          },
          {
            "field": "text_legible",
            "op": "eq",
            "value": false
          }
        ]
      },
      "method_ids": [
        "M01"
      ],
      "action": "clarify",
      "purpose": "仅核对会改变回复的一项缺口",
      "also_read": [
        "system/REPLY_PROTOCOL.md"
      ]
    },
    {
      "id": "R01",
      "name": "拒绝联系",
      "when": {
        "field": "refusal_scope",
        "op": "eq",
        "value": "contact"
      },
      "method_ids": [
        "M23"
      ],
      "action": "stop",
      "purpose": "停止私人联系；已回应过就不再发结束消息",
      "also_read": [
        "system/REPLY_PROTOCOL.md"
      ]
    },
    {
      "id": "R04",
      "name": "本轮已经发过",
      "when": {
        "all": [
          {
            "field": "pending_reply",
            "op": "eq",
            "value": true
          },
          {
            "field": "necessary_new_logistics",
            "op": "eq",
            "value": false
          }
        ]
      },
      "method_ids": [
        "M02"
      ],
      "action": "hold",
      "purpose": "最后是用户消息，不补发第二条",
      "also_read": [
        "system/REPLY_PROTOCOL.md"
      ]
    },
    {
      "id": "R04N",
      "name": "未回时独立必要事务",
      "when": {
        "all": [
          {
            "field": "pending_reply",
            "op": "eq",
            "value": true
          },
          {
            "field": "necessary_new_logistics",
            "op": "eq",
            "value": true
          }
        ]
      },
      "method_ids": [
        "M15"
      ],
      "action": "draft",
      "purpose": "只通知已核的独立必要新事务，不借机催回、重新邀约或假定对方已答应",
      "also_read": [
        "system/REPLY_PROTOCOL.md"
      ]
    },
    {
      "id": "R00S",
      "name": "安排与拒绝范围待核",
      "when": {
        "all": [
          {
            "field": "refusal_scope",
            "op": "eq",
            "value": "activity"
          },
          {
            "field": "invitation",
            "op": "in",
            "value": [
              "accepted",
              "alternative",
              "cancelled_with_repair",
              "open_to_activity"
            ]
          },
          {
            "field": "current_scope_relation",
            "op": "in",
            "value": [
              "unknown",
              "same"
            ]
          },
          {
            "field": "function",
            "op": "in",
            "value": [
              "unknown",
              "logistics",
              "sharing",
              "banter",
              "opening"
            ]
          },
          {
            "field": "advice_requested",
            "op": "eq",
            "value": false
          },
          {
            "field": "urgent_practical_need",
            "op": "eq",
            "value": false
          }
        ]
      },
      "method_ids": [
        "M01"
      ],
      "action": "clarify",
      "purpose": "只核当前安排与被拒活动是否同项；已有明确新同意则先更新事实，不擅自确认或重复拒绝",
      "also_read": [
        "system/REPLY_PROTOCOL.md"
      ]
    },
    {
      "id": "R02",
      "name": "身体界限",
      "when": {
        "all": [
          {
            "field": "refusal_scope",
            "op": "eq",
            "value": "physical"
          },
          {
            "field": "function",
            "op": "in",
            "value": [
              "unknown",
              "insult",
              "banter",
              "opening",
              "appreciation"
            ]
          },
          {
            "field": "advice_requested",
            "op": "eq",
            "value": false
          },
          {
            "field": "urgent_practical_need",
            "op": "eq",
            "value": false
          },
          {
            "field": "current_scope_relation",
            "op": "in",
            "value": [
              "unknown",
              "same"
            ]
          }
        ]
      },
      "method_ids": [
        "M23"
      ],
      "action": "draft",
      "purpose": "停止身体或性方向；如需回应仅简短承接，不将拒绝扩大成全部交流",
      "also_read": [
        "system/REPLY_PROTOCOL.md"
      ],
      "acknowledgement_only": true
    },
    {
      "id": "R03",
      "name": "拒绝恋爱发展",
      "when": {
        "all": [
          {
            "field": "refusal_scope",
            "op": "eq",
            "value": "romance"
          },
          {
            "field": "function",
            "op": "in",
            "value": [
              "unknown",
              "insult",
              "banter",
              "opening",
              "appreciation"
            ]
          },
          {
            "field": "advice_requested",
            "op": "eq",
            "value": false
          },
          {
            "field": "urgent_practical_need",
            "op": "eq",
            "value": false
          },
          {
            "field": "current_scope_relation",
            "op": "in",
            "value": [
              "unknown",
              "same"
            ]
          }
        ]
      },
      "method_ids": [
        "M23"
      ],
      "action": "draft",
      "purpose": "停止恋爱推进；普通交流不算撤回拒绝，如需回应只简短承接",
      "also_read": [
        "system/REPLY_PROTOCOL.md"
      ],
      "acknowledgement_only": true
    },
    {
      "id": "R05",
      "name": "明确话题或渠道边界",
      "when": {
        "all": [
          {
            "any": [
              {
                "field": "boundary_expressed",
                "op": "eq",
                "value": true
              },
              {
                "field": "refusal_scope",
                "op": "eq",
                "value": "channel"
              }
            ]
          },
          {
            "field": "function",
            "op": "in",
            "value": [
              "unknown",
              "insult",
              "banter",
              "opening",
              "appreciation"
            ]
          },
          {
            "field": "advice_requested",
            "op": "eq",
            "value": false
          },
          {
            "field": "urgent_practical_need",
            "op": "eq",
            "value": false
          },
          {
            "field": "current_scope_relation",
            "op": "in",
            "value": [
              "unknown",
              "same"
            ]
          }
        ]
      },
      "method_ids": [
        "M23"
      ],
      "action": "draft",
      "purpose": "停止已拒绝的话题或换平台请求；如需回应只简短承接",
      "also_read": [
        "system/REPLY_PROTOCOL.md"
      ],
      "acknowledgement_only": true
    },
    {
      "id": "R06",
      "name": "明确无礼",
      "when": {
        "field": "function",
        "op": "eq",
        "value": "insult"
      },
      "method_ids": [
        "M22"
      ],
      "action": "draft",
      "purpose": "仅对已确认的具体无礼设边界",
      "also_read": [
        "system/REPLY_PROTOCOL.md"
      ]
    },
    {
      "id": "R07",
      "name": "具体行为修复",
      "when": {
        "field": "repair_needed",
        "op": "eq",
        "value": true
      },
      "method_ids": [
        "M21"
      ],
      "action": "draft",
      "purpose": "先修复已确认的影响",
      "also_read": [
        "system/REPLY_PROTOCOL.md"
      ]
    },
    {
      "id": "R08",
      "name": "替代时间",
      "when": {
        "all": [
          {
            "any": [
              {
                "field": "invitation",
                "op": "eq",
                "value": "alternative"
              },
              {
                "field": "invitation",
                "op": "eq",
                "value": "cancelled_with_repair"
              }
            ]
          },
          {
            "all": [
              {
                "field": "function",
                "op": "in",
                "value": [
                  "unknown",
                  "logistics",
                  "sharing",
                  "banter",
                  "opening"
                ]
              },
              {
                "field": "advice_requested",
                "op": "eq",
                "value": false
              },
              {
                "field": "urgent_practical_need",
                "op": "eq",
                "value": false
              }
            ]
          }
        ]
      },
      "method_ids": [
        "M16"
      ],
      "action": "draft",
      "purpose": "落实替代安排优先于判断文字热度",
      "also_read": [
        "system/REPLY_PROTOCOL.md"
      ]
    },
    {
      "id": "R10",
      "name": "拒约无替代",
      "when": {
        "all": [
          {
            "field": "invitation",
            "op": "in",
            "value": [
              "no_alternative",
              "cancelled_without_repair"
            ]
          },
          {
            "all": [
              {
                "field": "function",
                "op": "in",
                "value": [
                  "unknown",
                  "logistics",
                  "banter",
                  "opening"
                ]
              },
              {
                "field": "advice_requested",
                "op": "eq",
                "value": false
              },
              {
                "field": "urgent_practical_need",
                "op": "eq",
                "value": false
              }
            ]
          },
          {
            "field": "current_scope_relation",
            "op": "in",
            "value": [
              "unknown",
              "same"
            ]
          }
        ]
      },
      "method_ids": [
        "M17"
      ],
      "action": "draft",
      "purpose": "没替代安排时不再追约；新增认真问题、求助或分享另按本轮作用回应",
      "also_read": [
        "system/REPLY_PROTOCOL.md"
      ]
    },
    {
      "id": "R11",
      "name": "只拒绝活动",
      "when": {
        "all": [
          {
            "field": "refusal_scope",
            "op": "eq",
            "value": "activity"
          },
          {
            "all": [
              {
                "field": "function",
                "op": "in",
                "value": [
                  "unknown",
                  "logistics",
                  "banter",
                  "opening"
                ]
              },
              {
                "field": "advice_requested",
                "op": "eq",
                "value": false
              },
              {
                "field": "urgent_practical_need",
                "op": "eq",
                "value": false
              }
            ]
          },
          {
            "field": "current_scope_relation",
            "op": "in",
            "value": [
              "unknown",
              "same"
            ]
          }
        ]
      },
      "method_ids": [
        "M23"
      ],
      "action": "draft",
      "purpose": "停止被拒绝的活动方向；新增认真内容仍可正常回应",
      "also_read": [
        "system/REPLY_PROTOCOL.md"
      ],
      "acknowledgement_only": true
    },
    {
      "id": "R09",
      "name": "活动意愿与安排",
      "when": {
        "all": [
          {
            "any": [
              {
                "field": "invitation",
                "op": "in",
                "value": [
                  "accepted",
                  "open_to_activity"
                ]
              },
              {
                "field": "function",
                "op": "eq",
                "value": "logistics"
              }
            ]
          },
          {
            "all": [
              {
                "field": "function",
                "op": "in",
                "value": [
                  "unknown",
                  "logistics",
                  "sharing",
                  "banter",
                  "opening"
                ]
              },
              {
                "field": "advice_requested",
                "op": "eq",
                "value": false
              },
              {
                "field": "urgent_practical_need",
                "op": "eq",
                "value": false
              }
            ]
          }
        ]
      },
      "method_ids": [
        "M15"
      ],
      "action": "draft",
      "purpose": "分清一般活动意愿和具体约定，只补当前关键的可行信息或安排",
      "also_read": [
        "system/REPLY_PROTOCOL.md"
      ]
    },
    {

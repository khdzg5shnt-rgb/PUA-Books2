      "when": {
        "all": [
          {
            "field": "current_turn_low",
            "op": "eq",
            "value": true
          },
          {
            "any": [
              {
                "field": "consecutive_low_rounds",
                "op": "gte",
                "value": 2
              },
              {
                "field": "reciprocity",
                "op": "eq",
                "value": "consistently_one_sided"
              }
            ]
          }
        ]
      },
      "method_ids": [
        "M19"
      ],
      "action": "hold",

          {
            "field": "closed_answer_complete",
            "op": "eq",
            "value": true
          },
          {
            "all": [
              {
                "field": "function",
                "op": "in",
                "value": [
                  "unknown",
                  "logistics",
                  "banter",
                  "opening"
                ]
              },
              {
                "field": "advice_requested",
                "op": "eq",
                "value": false
              },
              {
                "field": "urgent_practical_need",
                "op": "eq",
                "value": false
              }
            ]
          }
        ]
